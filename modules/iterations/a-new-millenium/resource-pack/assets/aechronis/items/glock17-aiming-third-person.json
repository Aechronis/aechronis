{
  "hand_animation_on_swap": false,
  "swap_animation_scale": 0,
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:charged_projectiles",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "thirdperson_righthand",
            "thirdperson_lefthand"
          ],
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:custom_model_data",
            "index": 0,
            "entries": [
              {
                "threshold": 1,
                "model": {
                  "type": "minecraft:model",
                  "model": "aechronis:item/glock17-crouching"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "aechronis:item/glock17-standing"
            }
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "aechronis:item/glock17-first-person-hip"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "aechronis:item/glock17"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "aechronis:item/glock17"
    }
  }
}
