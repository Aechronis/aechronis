{
  "hand_animation_on_swap": false,
  "swap_animation_scale": 1,
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "firstperson_righthand",
        "model": {
          "type": "minecraft:model",
          "model": "aechronis:item/awp-animation-aim-right",
          "tints": [
            {
              "type": "minecraft:custom_model_data",
              "index": 0,
              "default": 16777215
            }
          ]
        }
      },
      {
        "when": "firstperson_lefthand",
        "model": {
          "type": "minecraft:model",
          "model": "aechronis:item/awp-animation-aim-left",
          "tints": [
            {
              "type": "minecraft:custom_model_data",
              "index": 0,
              "default": 16777215
            }
          ]
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "thirdperson_righthand",
            "thirdperson_lefthand"
          ],
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:custom_model_data",
            "index": 0,
            "entries": [
              {
                "threshold": 1,
                "model": {
                  "type": "minecraft:model",
                  "model": "aechronis:item/awp-crouching"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "aechronis:item/awp-standing"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "aechronis:item/awp-aiming"
      }
    }
  }
}
