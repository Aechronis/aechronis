{
  "multipart": [
    {
      "when": {
        "down": "false",
        "east": "false",
        "north": "false",
        "south": "false",
        "up": "false",
        "west": "false"
      },
      "apply": { "model": "aechronis:block/sculk_vein_empty" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "minecraft:block/sculk_vein" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "minecraft:block/sculk_vein", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "minecraft:block/sculk_vein", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "minecraft:block/sculk_vein", "y": 270, "uvlock": true }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "minecraft:block/sculk_vein", "x": 270, "uvlock": true }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "minecraft:block/sculk_vein", "x": 90, "uvlock": true }
    }
  ]
}
